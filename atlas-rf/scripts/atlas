#!/bin/sh
# Source checkout launcher for an offline venv without pip/setuptools.
set -eu
atlas_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
if [ ! -x "$atlas_root/.venv/bin/python" ]; then
    echo 'Create .venv first; see docs/installation.md.' >&2
    exit 2
fi
PYTHONPATH="$atlas_root${PYTHONPATH:+:$PYTHONPATH}" exec "$atlas_root/.venv/bin/python" -m atlas "$@"
